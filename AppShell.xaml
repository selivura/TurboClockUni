<?xml version="1.0" encoding="UTF-8" ?>

<Shell
    x:Class="TurboClock.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:TurboClock.Pages"
    Shell.NavBarIsVisible="False"
    Title="Turbo clock!">

    <TabBar>
        <ShellContent
            Title="Clock"
            ContentTemplate="{DataTemplate pages:ClockPage}" />

        <ShellContent
            Title="Timer"
            ContentTemplate="{DataTemplate pages:TimerPage}" />
        
        <ShellContent
            Title="World Clock"
            ContentTemplate="{DataTemplate pages:WorldClockPage}" />

    </TabBar>
</Shell>